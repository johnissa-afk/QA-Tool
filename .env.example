# Optional HTTP Basic Authentication. Set both variables together.
QA_BASIC_AUTH_USER=
QA_BASIC_AUTH_PASSWORD=

# Legacy Basic Auth names remain supported for compatibility.
QA_USERNAME=
QA_PASSWORD=

# Optional Authorization header, for example: Bearer <token>
QA_AUTHORIZATION=

# Optional AI-enhanced QA analysis. Leave blank to run in deterministic mode.
# The key is used only in the Authorization header and is never logged or reported.
AI_API_KEY=
# Optional OpenAI-compatible chat completions endpoint (default: https://api.openai.com/v1/chat/completions)
AI_API_URL=
# Optional model name (default: gpt-4o-mini)
AI_MODEL=

# Optional SMTP delivery for QA notifications. Every value is read from the
# environment at send time and is never written to a project, report or delivery
# file, never returned by an API, and never logged. Without a complete set
# (SMTP_HOST and SMTP_FROM, plus SMTP_USER and SMTP_PASSWORD together) an email
# delivery fails as EMAIL_NOT_CONFIGURED without contacting any server.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typical of port 465); defaults from the port otherwise.
SMTP_SECURE=
# Optional. Set both together, or leave both blank for an unauthenticated server.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional display name for the sender, e.g. AI Website QA
SMTP_FROM_NAME=
