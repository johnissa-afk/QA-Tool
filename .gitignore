node_modules/
dist/
reports/
playwright-report/
test-results/
# Locally generated Playwright specs (npm run generate-tests) and local run
# logs. Both are rebuilt on demand and are machine-specific, so they are not
# part of the release.
generated/
logs/
# Published baseline artifacts live here so they can be committed (reports/ is
# ignored). They contain a QaAnalysis snapshot and are safe to track; the
# integrity sidecar (.meta.json) must travel with the artifact.
!/.qa-baseline/
# Playwright storage state — holds live session cookies/tokens.
playwright-auth.json
.env
.env.*
!.env.example
